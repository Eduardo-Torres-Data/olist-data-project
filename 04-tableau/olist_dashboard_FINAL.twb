    <worksheet name='Lateness'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_order_items+' name='federated.0x6vsgz1yty16d1apniim130vmut' />
          </datasources>
          <datasource-dependencies datasource='federated.0x6vsgz1yty16d1apniim130vmut'>
            <column caption='Is Late' datatype='string' name='[Calculation_2230996535189506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([delivered_date_sk]) THEN &quot;Not delivered&quot;&#10;ELSEIF [delivered_date_sk] &gt; [estimated_delivery_sk] THEN &quot;Late&quot;&#10;ELSE &quot;On time&quot;&#10;END' />
            </column>
            <column caption='Lateness' datatype='real' name='[Calculation_2552742180868099]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT (IF [Calculation_2230996535189506] = &quot;Late&quot; THEN 1 END) /&#10;COUNT(IF [Calculation_2230996535189506] &lt;&gt; &quot;Not delivered&quot; THEN 1 END)' />
            </column>
            <column caption='Customer Region' datatype='string' name='[customer_region]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Centro-Oeste&quot;' value='West Central' />
                <alias key='&quot;Nordeste&quot;' value='Northeast' />
                <alias key='&quot;Norte&quot;' value='North' />
                <alias key='&quot;Sudeste&quot;' value='Southeast' />
                <alias key='&quot;Sul&quot;' value='South' />
              </aliases>
