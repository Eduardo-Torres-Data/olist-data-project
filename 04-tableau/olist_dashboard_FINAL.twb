                <zone fixed-size='94' h='13056' id='7' is-fixed='true' param='horz' type-v2='layout-flow' w='98638' x='681' y='1111'>
                  <zone forceUpdate='true' h='13056' id='11' type-v2='text' w='98638' x='681' y='1111'>
                    <formatted-text>
                      <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Benton Sans Book' fontsize='24' italic='true'>Delivery reliability drops sharply outside the Southeast</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                    </zone-style>
                  </zone>
                </zone>
              </zone>
              <zone fixed-size='197' h='27361' id='26' is-fixed='true' param='horz' type-v2='layout-flow' w='98638' x='681' y='14167'>
                <zone h='27361' id='27' name='Avg Delivery Days by Region' show-title='false' w='98638' x='681' y='14167'>
                  <layout-cache fixed-size-h='155' minwidth='240' type-h='fixed' type-w='scalable' />
                  <zone-style>
                    <format attr='border-color' value='#f5f5f5' />
                    <format attr='border-style' value='solid' />
                    <format attr='border-width' value='4' />
                    <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='20' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
              <zone fixed-size='381' h='52917' id='28' is-fixed='true' param='horz' type-v2='layout-flow' w='98638' x='681' y='41528'>
                <zone h='52917' id='29' param='horz' type-v2='layout-flow' w='98638' x='681' y='41528'>
                  <zone fixed-size='333' forceUpdate='true' h='52917' id='30' is-fixed='true' type-v2='text' w='28510' x='681' y='41528'>
                    <formatted-text>
                      <run bold='true' fontalignment='1' fontcolor='#555555' fontname='Benton Sans Book' fontsize='72'>2.1x</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#555555' fontname='Benton Sans Book' fontsize='24' italic='true'>longer average delivery time in the North (22.6 days) vs the Southeast (10.6 days)</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#f5f5f5' />
                      <format attr='border-style' value='solid' />
                      <format attr='border-width' value='4' />
                      <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='20' />
                      <format attr='margin' value='1' />
                      <format attr='padding' value='10' />
                    </zone-style>
                  </zone>
                  <zone h='52917' id='31' param='horz' type-v2='layout-flow' w='70128' x='29191' y='41528'>
                    <zone h='52917' id='32' type-v2='text' w='70128' x='29191' y='41528'>
                      <formatted-text>
                        <run fontalignment='1' fontname='Benton Sans Book' fontsize='18'>Delivery performance varies sharply by region, and the pattern tracks distance from the Southeast almost perfectly. Customers in the North wait an average of 22.6 days for their orders, more than double the 10.6 days typical in the Southeast. The Northeast follows a similar trend, while Central-West and South sit in between. This is not a marginal difference — it means customers in Olist&apos;s weakest revenue regions are also the ones experiencing the platform&apos;s least reliable service, a pattern that likely reinforces rather than corrects the geographic imbalance seen in the first chart.</run>
                      </formatted-text>
                      <zone-style>
                        <format attr='border-color' value='#f5f5f5' />
                        <format attr='border-style' value='solid' />
                        <format attr='border-width' value='4' />
                        <_.fcp.DashboardRoundedCorners.true...format attr='corner-radius' value='20' />
                        <format attr='margin' value='4' />
                        <format attr='padding' value='10' />
                      </zone-style>
                    </zone>
                  </zone>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
