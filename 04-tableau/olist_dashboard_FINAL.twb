      <column caption='Total Orders' datatype='integer' name='[Calculation_0554579255951361]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Is Late' datatype='string' name='[Calculation_2230996535189506]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([delivered_date_sk]) THEN &quot;Not delivered&quot;&#10;ELSEIF [delivered_date_sk] &gt; [estimated_delivery_sk] THEN &quot;Late&quot;&#10;ELSE &quot;On time&quot;&#10;END' />
      </column>
      <column caption='% Is Late' datatype='real' name='[Calculation_2230996536918020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Calculation_2230996535189506]) / TOTAL(COUNT([order_id (fact_orders.csv)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Delivery Days' datatype='integer' name='[Calculation_2552741850251264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [purchase_date_sk], [delivered_date_sk])' />
      </column>
      <column caption='Avg Ticket' datatype='real' name='[Calculation_2552742176833538]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([price]) / COUNTD([order_id])' />
      </column>
      <column caption='Lateness' datatype='real' name='[Calculation_2552742180868099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT (IF [Calculation_2230996535189506] = &quot;Late&quot; THEN 1 END) /&#10;COUNT(IF [Calculation_2230996535189506] &lt;&gt; &quot;Not delivered&quot; THEN 1 END)' />
      </column>
      <column caption='Score by Order in Reviews' datatype='integer' name='[Calculation_2906029374496768]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [order_id (fact_order_reviews.csv)] : MIN([review_score])}' />
      </column>
      <column caption='% Bad Reviews' datatype='real' name='[Calculation_2906029375016961]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [seller_id] : COUNTD(IF [Calculation_2906029374496768] &lt;= 2 THEN [order_id] END)} &#10;/&#10;{FIXED [seller_id] : COUNTD([order_id])}' />
      </column>
      <column caption='Ranking worst sellers' datatype='integer' name='[Calculation_2906029395914755]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(MIN([Calculation_2906029375016961]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Orders by Unique Customer' datatype='integer' name='[Calculation_2906029722083332]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{FIXED [customer_unique_id] : COUNTD([order_id (fact_orders.csv)])}' />
      </column>
      <column caption='Customer spending' datatype='real' name='[Calculation_2906029728133125]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [customer_unique_id] : SUM([price])}' />
      </column>
      <column caption='Customer Type' datatype='string' name='[Calculation_2906029734187015]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2906029722083332] &gt;= 2 THEN &quot;Repeat&quot; &#10;ELSE &quot;One Time&quot; END' />
      </column>
      <column caption='% buyback' datatype='real' name='[Calculation_2906029738430472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_2906029734187015]=&quot;Repeat&quot; THEN [customer_unique_id] END)&#10;/ COUNTD([customer_unique_id])' />
      </column>
      <column aggregation='None' caption='Customer spending (bin)' datatype='integer' name='[Customer spending (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[Calculation_2906029728133125]' peg='0' size='50' />
      </column>
      <column aggregation='None' caption='Delivery Days (bin)' datatype='integer' name='[Delivery Days (bin)]' role='dimension' type='ordinal'>
