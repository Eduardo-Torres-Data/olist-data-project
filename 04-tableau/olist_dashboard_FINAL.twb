    <worksheet name='Delivery Speed'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#666666'>Late Delivery Shipping Ratio</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_order_items+' name='federated.0x6vsgz1yty16d1apniim130vmut' />
          </datasources>
          <datasource-dependencies datasource='federated.0x6vsgz1yty16d1apniim130vmut'>
            <column caption='Is Late' datatype='string' name='[Calculation_2230996535189506]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([delivered_date_sk]) THEN &quot;Not delivered&quot;&#10;ELSEIF [delivered_date_sk] &gt; [estimated_delivery_sk] THEN &quot;Late&quot;&#10;ELSE &quot;On time&quot;&#10;END' />
            </column>
            <column caption='% Is Late' datatype='real' name='[Calculation_2230996536918020]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([Calculation_2230996535189506]) / TOTAL(COUNT([order_id (fact_orders.csv)]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column-instance column='[order_sk]' derivation='Count' name='[cnt:order_sk:qk]' pivot='key' type='quantitative' />
            <column caption='Customer Region' datatype='string' name='[customer_region]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Centro-Oeste&quot;' value='West Central' />
                <alias key='&quot;Nordeste&quot;' value='Northeast' />
                <alias key='&quot;Norte&quot;' value='North' />
                <alias key='&quot;Sudeste&quot;' value='Southeast' />
                <alias key='&quot;Sul&quot;' value='South' />
              </aliases>
            </column>
            <column caption='Customer State' datatype='string' name='[customer_state]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column caption='Delivered Date Sk' datatype='date' name='[delivered_date_sk]' role='dimension' type='ordinal' />
            <column caption='Estimated Delivery Sk' datatype='date' name='[estimated_delivery_sk]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_2230996535189506]' derivation='None' name='[none:Calculation_2230996535189506:nk]' pivot='key' type='nominal' />
            <column-instance column='[customer_region]' derivation='None' name='[none:customer_region:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
            <column caption='Order Id (Fact Orders.Csv)' datatype='string' name='[order_id (fact_orders.csv)]' role='dimension' type='nominal' />
            <column caption='Order Sk' datatype='integer' name='[order_sk]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2230996536918020]' derivation='User' name='[usr:Calculation_2230996536918020:qk:1]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0x6vsgz1yty16d1apniim130vmut].[Tooltip (Customer Region)]'>
            <groupfilter function='level-members' level='[customer_region]' user:ui-action-filter='[Action - Delivery Speed]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0x6vsgz1yty16d1apniim130vmut].[Tooltip (Customer Region,Customer State)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action - Delivery Speed]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[customer_region]' />
              <groupfilter function='level-members' level='[customer_state]' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.0x6vsgz1yty16d1apniim130vmut].[Tooltip (Customer State)]'>
            <groupfilter function='level-members' level='[customer_state]' user:ui-action-filter='[Action - Delivery Speed]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.0x6vsgz1yty16d1apniim130vmut].[none:Calculation_2230996535189506:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:Calculation_2230996535189506:nk]' member='&quot;Late&quot;' />
              <groupfilter function='member' level='[none:Calculation_2230996535189506:nk]' member='&quot;On time&quot;' />
            </groupfilter>
          </filter>
          <natural-sort column='[federated.0x6vsgz1yty16d1apniim130vmut].[none:Calculation_2230996535189506:nk]' direction='DESC' />
          <slices>
            <column>[federated.0x6vsgz1yty16d1apniim130vmut].[none:Calculation_2230996535189506:nk]</column>
            <column>[federated.0x6vsgz1yty16d1apniim130vmut].[none:customer_region:nk]</column>
