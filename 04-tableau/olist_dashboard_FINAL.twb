    <worksheet name='Customer satisfaction drops as delivery slows'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#666666'>Satisfaction Drops as Delivery Slows</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='fact_order_items+' name='federated.0x6vsgz1yty16d1apniim130vmut' />
