                    <zone fixed-size='407' h='56528' id='15' is-fixed='true' param='horz' type-v2='layout-flow' w='30978' x='68341' y='41667'>
                      <zone forceUpdate='true' h='56528' id='16' type-v2='text' w='30978' x='68341' y='41667'>
                        <formatted-text>
                          <run bold='true' fontalignment='1' fontcolor='#898989' fontname='Benton Sans Book' fontsize='12'>Revenue is heavily concentrated in a single region of Brazil. The Southeast  anchored by São Paulo, with Rio de Janeiro as a secondary contributor  accounts for the overwhelming majority of the platform&apos;s gross merchandise value, while every other region contributes only a fraction by comparison. When customer revenue is mapped by state, São Paulo alone dwarfs every other market, and this heavy reliance on one region carries real risk: any disruption there would have an outsized impact on overall performance</run>
                        </formatted-text>
                        <zone-style>
                          <format attr='border-color' value='#e6e6e6' />
                          <format attr='border-style' value='solid' />
                          <format attr='border-width' value='4' />
